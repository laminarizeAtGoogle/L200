# Example Terraform Variables for Argolis
# Copy this file to terraform.tfvars and fill in your Argolis project ID
# cp terraform.tfvars.example terraform.tfvars

project_id        = "your-argolis-project-id"
region            = "us-central1"
zone              = "us-central1-a"
instance_name     = "argolis-dev-vm"
machine_type      = "e2-standard-4"
boot_disk_size_gb = 50
