#!/usr/bin/env bash
set -e

# Resolve workspace root directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Ensure isolated gcloud environment is loaded
GCLOUD_BIN="${WORKSPACE_DIR}/bin/gcloud"
export CLOUDSDK_CONFIG="${WORKSPACE_DIR}/.gcloud"
export GOOGLE_APPLICATION_CREDENTIALS="${WORKSPACE_DIR}/.gcloud/application_default_credentials.json"

usage() {
  cat <<EOF
Argolis GCP Instance Management Helper
Usage: ./bin/argolis <command> [arguments]

Commands:
  status                   Show active GCP account, project, region, and zone
  auth                     Run interactive gcloud login and application-default login
  set-project <PROJECT_ID> Set the active Argolis GCP project ID
  set-zone <ZONE>          Set the default compute zone (e.g., us-central1-a)
  set-region <REGION>      Set the default compute region (e.g., us-central1)
  list | instances         List all Compute Engine instances in the active project
  describe <NAME>          Show details of a specific Compute Engine instance
  start <NAME>             Start a Compute Engine instance
  stop <NAME>              Stop a Compute Engine instance
  ssh <NAME> [ARGS...]     SSH into a Compute Engine instance
  gcloud [ARGS...]         Run an arbitrary gcloud command in the isolated environment

Examples:
  ./bin/argolis status
  ./bin/argolis set-project argolis-user-demo-1234
  ./bin/argolis list
  ./bin/argolis ssh my-argolis-instance
EOF
}

COMMAND="$1"
shift || true

case "${COMMAND}" in
  status)
    echo "=== Active Argolis Environment ==="
    echo "Config dir: ${CLOUDSDK_CONFIG}"
    "${GCLOUD_BIN}" config list 2>/dev/null || echo "Run './bin/argolis auth' to configure credentials."
    ;;
  auth)
    echo "Authenticating gcloud CLI..."
    "${GCLOUD_BIN}" auth login
    echo "Authenticating Application Default Credentials (ADC) for Terraform/SDKs..."
    "${GCLOUD_BIN}" auth application-default login
    ;;
  set-project)
    if [ -z "$1" ]; then
      echo "Error: Project ID required. Usage: ./bin/argolis set-project <PROJECT_ID>" >&2
      exit 1
    fi
    "${GCLOUD_BIN}" config set project "$1"
    echo "Active project set to: $1"
    ;;
  set-zone)
    if [ -z "$1" ]; then
      echo "Error: Zone required. Usage: ./bin/argolis set-zone <ZONE>" >&2
      exit 1
    fi
    "${GCLOUD_BIN}" config set compute/zone "$1"
    echo "Compute zone set to: $1"
    ;;
  set-region)
    if [ -z "$1" ]; then
      echo "Error: Region required. Usage: ./bin/argolis set-region <REGION>" >&2
      exit 1
    fi
    "${GCLOUD_BIN}" config set compute/region "$1"
    echo "Compute region set to: $1"
    ;;
  list|instances)
    "${GCLOUD_BIN}" compute instances list "$@"
    ;;
  describe)
    if [ -z "$1" ]; then
      echo "Error: Instance name required. Usage: ./bin/argolis describe <NAME>" >&2
      exit 1
    fi
    "${GCLOUD_BIN}" compute instances describe "$@"
    ;;
  start)
    if [ -z "$1" ]; then
      echo "Error: Instance name required. Usage: ./bin/argolis start <NAME>" >&2
      exit 1
    fi
    "${GCLOUD_BIN}" compute instances start "$@"
    ;;
  stop)
    if [ -z "$1" ]; then
      echo "Error: Instance name required. Usage: ./bin/argolis stop <NAME>" >&2
      exit 1
    fi
    "${GCLOUD_BIN}" compute instances stop "$@"
    ;;
  ssh)
    if [ -z "$1" ]; then
      echo "Error: Instance name required. Usage: ./bin/argolis ssh <NAME> [ARGS...]" >&2
      exit 1
    fi
    "${GCLOUD_BIN}" compute ssh "$@"
    ;;
  gcloud)
    "${GCLOUD_BIN}" "$@"
    ;;
  help|--help|-h|"")
    usage
    ;;
  *)
    echo "Unknown command: ${COMMAND}" >&2
    usage
    exit 1
    ;;
esac
