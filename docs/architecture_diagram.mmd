flowchart TD
    %% Architecture Diagram: Gemini Enterprise Cloud Chat Agent & Argolis Infrastructure

    subgraph Zone1["1. Gemini Enterprise Frontend & Ingress (Perimeter Zone)"]
        direction TB
        ge_frontend["Gemini Enterprise Web UI<br/>• Voice Recording (Web Speech)<br/>• Markdown Chat Feed<br/>• TTS Audio Playback<br/>• Status & Identity Badges"]
        iap_gateway["Google Identity-Aware Proxy (IAP)<br/>• Cryptographic JWT Assertion<br/>• Caller Authorization Verification<br/>• Google Login Perimeter"]
        cloudtop_shell["Developer Shell & Workstation<br/>• Hermetic Toolchain (Terraform v1.16.4)<br/>• 25 Core Skills + 13 On-Demand /fde-* Workflows<br/>• Pre-Push Credential & OSPO Sanitization Gate<br/>• Automated Architecture Validation"]
    end

    subgraph Zone2["2. Gemini 3.8 Agent Engine & Security Boundaries (Execution Zone)"]
        direction TB
        cloud_chat_agent["Gemini Enterprise Cloud Chat Agent<br/>• Conversational Coordinator<br/>• Strategic Model Routing (Flash / Pro)<br/>• Context Compaction & Episodic Memory"]
        
        subgraph AgentServices["Agent Capabilities & Guardrails"]
            direction LR
            cloud_tts_engine["Google Cloud TTS Voice Engine<br/>• Journey & Neural2 Voices<br/>• Markdown Speech Cleaning"]
            db_quarantine_barrier["Database Access Blocker Guardrail<br/>• Strictly Blocks SQL/Spanner/Firestore<br/>• Directs Diagnostics to Cloud Logging"]
            readonly_cloud_prober["Read-Only Cloud Prober<br/>• Zero Mutating Verbs<br/>• Probes VMs, Run, Storage, IAM"]
            cloud_logging_prober["Cloud Logging Prober<br/>• Authorized Telemetry Queries<br/>• Audit Trails & Error Traces"]
        end
    end

    subgraph Zone3["3. GitHub CI/CD & Security Boundary (Governance Zone)"]
        direction TB
        subgraph GithubPlatform["GitHub Actions Platform"]
            github_repo["GitHub Repository (L200 Mainline)<br/>• Branch Protection & Policy<br/>• Embedded PR Context & History"]
            agent_eval_pipeline["Golden Eval pytest Suite<br/>• 26 Automated Tests<br/>• 7/7 Golden Dataset Pass Rate"]
            gha_plan["Terraform Plan Pipeline<br/>• Automated PR Validation"]
        end
        subgraph IamSecurity["Google Cloud IAM & Workload Identity"]
            wif_pool["Workload Identity Pool & Provider<br/>• Keyless OIDC STS Token Exchange"]
            reader_sa["cloudtop-agent-reader SA<br/>• Restricted Viewer & Logging Viewer"]
        end
    end

    subgraph Zone4["4. Google Cloud Argolis Infrastructure (Resource Zone)"]
        direction TB
        subgraph ServerlessVault["Serverless Compute & Secret Vault"]
            cloud_run_factory_service["Cloud Run Service<br/>• Containerized FastAPI Server<br/>• Hosts Frontend Behind IAP"]
            secret_manager_vault["Secret Manager & Cloud DLP Vault<br/>• Zero Hardcoded Credentials<br/>• Automated PII Scrubbing"]
        end
        subgraph LoggingZone["Cloud Logging Systems"]
            cloud_logging["Cloud Logging API<br/>• Authorized Diagnostic Telemetry<br/>• System & Application Logs"]
        end
        subgraph ComputeZone["Compute Resources"]
            compute_vm["Compute Engine & Cloud Run Workloads<br/>• Monitored Infrastructure Assets"]
        end
        subgraph QuarantinedDBs["Strictly Quarantined Tier"]
            internal_databases["Internal Application Databases<br/>• Cloud SQL, Spanner, Firestore<br/>⛔ DIRECT AGENT QUERY PROHIBITED"]
        end
    end

    %% Client Ingress Flow
    ge_frontend -->|HTTPS / Google Login| iap_gateway
    iap_gateway -->|HTTPS / Verified JWT Assertion| cloud_chat_agent
    cloud_run_factory_service -.->|Serves Static UI| ge_frontend

    %% Agent Internal Routing
    cloud_chat_agent -->|gRPC / Runtime SA Token| cloud_tts_engine
    cloud_chat_agent -->|Inspection Dispatch| readonly_cloud_prober
    cloud_chat_agent -->|Log Inspection Request| cloud_logging_prober
    cloud_chat_agent -->|Enforce Policy Hook| db_quarantine_barrier

    %% Guardrail Quarantine
    db_quarantine_barrier -.-x|ACCESS DENIED / Quarantined Wall| internal_databases

    %% Cloud Probing & Observability
    readonly_cloud_prober -->|IAM SA Impersonation| reader_sa
    reader_sa -->|GCP Resource APIs / Viewer| compute_vm
    reader_sa -->|Cloud Logging API / Logging Viewer| cloud_logging
    cloud_logging_prober -->|Read Error Logs| cloud_logging

    %% Infrastructure & Secrets
    cloud_run_factory_service -->|Read Config / Secret Accessor| secret_manager_vault

    %% CI/CD & Governance
    github_repo -->|Trigger on Push/PR| agent_eval_pipeline
    github_repo -->|Trigger on PR| gha_plan
    agent_eval_pipeline -->|HTTPS / GitHub OIDC Token| wif_pool
    wif_pool -->|Federated STS Credential| reader_sa

    %% Styling Classes
    classDef perimeter fill:#e8f0fe,stroke:#8ab4f8,stroke-width:2px,color:#202124;
    classDef execution fill:#fce8e6,stroke:#f6aea9,stroke-width:2px,color:#202124;
    classDef governance fill:#e6f4ea,stroke:#81c995,stroke-width:2px,color:#202124;
    classDef resource fill:#fef7e0,stroke:#fde293,stroke-width:2px,color:#202124;
    classDef blocked fill:#fff8f7,stroke:#d93025,stroke-width:2px,color:#d93025;
    classDef coreAgent fill:#ffffff,stroke:#1a73e8,stroke-width:3px,color:#1a73e8,font-weight:bold;

    class ge_frontend,iap_gateway,cloudtop_shell perimeter;
    class cloud_tts_engine,readonly_cloud_prober,cloud_logging_prober execution;
    class cloud_chat_agent coreAgent;
    class github_repo,agent_eval_pipeline,gha_plan,wif_pool,reader_sa governance;
    class cloud_run_factory_service,secret_manager_vault,cloud_logging,compute_vm resource;
    class db_quarantine_barrier,internal_databases blocked;
