# Isolated GCP & Workspace SDK Paths
CLOUDSDK_CONFIG={WORKSPACE_DIR}/.gcloud
GOOGLE_APPLICATION_CREDENTIALS={WORKSPACE_DIR}/.gcloud/application_default_credentials.json

# Workspace Binaries in PATH
PATH={WORKSPACE_DIR}/bin:$PATH

# OpenSpec Configuration
export OPENSPEC_TELEMETRY=0

# Internal UV & Python Mirror Configuration
UV_INDEX_URL=http://airlock-proxy.uplink.goog:999/python/artifact-foundry-prod/ah-3p-staging-python/simple/
UV_INSECURE_HOST=airlock-proxy.uplink.goog
UV_PYTHON_INSTALL_DIR={WORKSPACE_DIR}/.python

# Argolis GCP Project Configuration (Update with your project ID)
ARGOLIS_PROJECT_ID={ARGOLIS_PROJECT_ID}
ARGOLIS_REGION={ARGOLIS_REGION}
ARGOLIS_ZONE={ARGOLIS_ZONE}

# Terraform Automatic Variable Binding
TF_VAR_project_id=${ARGOLIS_PROJECT_ID}
TF_VAR_region=${ARGOLIS_REGION}
TF_VAR_zone=${ARGOLIS_ZONE}

